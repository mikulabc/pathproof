# Optional: enables model-assisted action planning during the first discovery.
OPENAI_API_KEY=
PATHPROOF_AI_MODEL=gpt-5.6-luna
# Test/development switch that guarantees the local planner path.
PATHPROOF_DISABLE_AI=0

# Local target fixtures are blocked unless explicitly enabled for development.
PATHPROOF_ALLOW_LOCALHOST=0
PATHPROOF_MAX_PAGES=20
PATHPROOF_NAVIGATION_TIMEOUT_MS=20000
PATHPROOF_CONCURRENCY=4
PATHPROOF_STREAM_FPS=60
PATHPROOF_IMPORT_LIMIT=250mb
PATHPROOF_HEADFUL=0
PATHPROOF_IGNORE_HTTPS_ERRORS=0
PORT=43827
