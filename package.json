{
  "name": "pathproof",
  "version": "0.1.2",
  "description": "Local-first AI-assisted website regression discovery and deterministic Playwright replay.",
  "private": true,
  "license": "MIT",
  "author": "Mikula Beutl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikulabc/pathproof.git"
  },
  "bugs": {
    "url": "https://github.com/mikulabc/pathproof/issues"
  },
  "homepage": "https://github.com/mikulabc/pathproof#readme",
  "keywords": ["playwright", "regression-testing", "browser-automation", "visual-testing", "ai-testing"],
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm run typecheck && pnpm test && pnpm run validate:extension && pnpm run build",
    "validate:extension": "node --check chrome-extension/background.js && node --check chrome-extension/content-script.js && node --check chrome-extension/recorder.js && node --check chrome-extension/panel.js && node -e \"JSON.parse(require('fs').readFileSync('chrome-extension/manifest.json','utf8'))\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "openai": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "30.0.1",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
